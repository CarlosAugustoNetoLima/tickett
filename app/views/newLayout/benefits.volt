<section class="tkt-scope tkt-section" style="padding-top: 0;">
	<div class="tkt-container">

		<div class="tkt-banner">
			<div class="tkt-banner__left">
				<div class="tkt-banner__chip">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
				</div>
				<div class="tkt-banner__text">
					<p class="tkt-banner__title">{{ t._('São') }} <strong>+500</strong> {{ t._('eventos em toda a Europa, Portugal e África.') }}</p>
				</div>
			</div>
			<a href="{{ url() }}search" class="tkt-btn tkt-btn--primary">{{ t._('Ver mais') }}</a>
		</div>

	</div>
</section>

<div style="background: var(--tkt-bg-elevated); height: 1px; width: 100%; max-width: 1440px; margin: 0 auto;"></div>

<section class="tkt-scope">
	<div class="tkt-container">
		<div class="tkt-showcase-head">
			<span class="tkt-section__eyebrow">{{ t._('ESCOLHA TICKETT.COM') }}</span>
			<h2 class="tkt-section__title">{{ t._('Por que escolher a Tickett.com?') }}</h2>
		</div>

		<div class="tkt-benefit-row">
			<div class="tkt-benefit-row__text">
				<p class="tkt-benefit-row__number">01</p>
				<div class="tkt-benefit-row__divider"></div>
				<div>
					<p class="tkt-benefit-row__title">{{ t._('Bilhetes Oficiais') }}</p>
					<p class="tkt-benefit-row__desc">{{ t._('Trabalhamos diretamente com promotores e salas para garantir bilhetes 100% oficiais.') }}</p>
				</div>
			</div>
			<div class="tkt-benefit-row__visual">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 96px; height: 96px; color: var(--tkt-accent-primary); opacity: .9;"><path d="M3 10a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1.5a1.5 1.5 0 0 0 0-3z"></path><line x1="10" y1="8" x2="10" y2="16" stroke-dasharray="2 2"></line></svg>
			</div>
		</div>

		<div class="tkt-benefit-row">
			<div class="tkt-benefit-row__text">
				<p class="tkt-benefit-row__number">02</p>
				<div class="tkt-benefit-row__divider"></div>
				<div>
					<p class="tkt-benefit-row__title">{{ t._('Recebe por WhatsApp') }}</p>
					<p class="tkt-benefit-row__desc">{{ t._('Bilhete digital enviado para o teu WhatsApp. Mais rápido, simples e seguro.') }}</p>
				</div>
			</div>
			<div class="tkt-benefit-row__visual">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="width: 96px; height: 96px; color: var(--tkt-accent-primary); opacity: .9;"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.77.46 3.45 1.28 4.93L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.34-.5.05-1 .25-3.37-.7-2.85-1.14-4.68-4.03-4.82-4.22-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.35.26-.28.56-.35.75-.35.19 0 .38 0 .54.01.18.01.41-.07.64.49.24.58.81 2 .88 2.15.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.14-.28.29-.12.57.16.28.71 1.17 1.52 1.9 1.05.94 1.93 1.23 2.21 1.37.28.14.45.12.61-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.65.78 1.94.92.28.14.47.21.54.33.07.12.07.68-.17 1.32z"></path></svg>
			</div>
		</div>

		<div class="tkt-benefit-row">
			<div class="tkt-benefit-row__text">
				<p class="tkt-benefit-row__number">03</p>
				<div class="tkt-benefit-row__divider"></div>
				<div>
					<p class="tkt-benefit-row__title">{{ t._('Portugal, Europa e África') }}</p>
					<p class="tkt-benefit-row__desc">{{ t._('A maior seleção de concertos da música lusófona num só lugar.') }}</p>
				</div>
			</div>
			<div class="tkt-benefit-row__visual">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="width: 96px; height: 96px; color: var(--tkt-accent-primary); opacity: .9;"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
			</div>
		</div>
	</div>
</section>

<div style="background: var(--tkt-bg-elevated); height: 1px; width: 100%; max-width: 1440px; margin: 0 auto;"></div>

<section class="tkt-scope">
	<div class="tkt-container" style="padding: 40px 80px;">
		<div class="tkt-banner">
			<div class="tkt-banner__left">
				<div class="tkt-banner__chip">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.77.46 3.45 1.28 4.93L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01c5.46 0 9.91-4.45 9.91-9.91C21.96 6.45 17.5 2 12.04 2zm5.8 14.06c-.24.68-1.4 1.3-1.93 1.34-.5.05-1 .25-3.37-.7-2.85-1.14-4.68-4.03-4.82-4.22-.14-.19-1.15-1.53-1.15-2.92 0-1.39.73-2.07.99-2.35.26-.28.56-.35.75-.35.19 0 .38 0 .54.01.18.01.41-.07.64.49.24.58.81 2 .88 2.15.07.14.12.31.02.5-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.14-.28.29-.12.57.16.28.71 1.17 1.52 1.9 1.05.94 1.93 1.23 2.21 1.37.28.14.45.12.61-.07.17-.19.71-.83.9-1.11.19-.28.38-.24.63-.14.26.09 1.65.78 1.94.92.28.14.47.21.54.33.07.12.07.68-.17 1.32z"></path></svg>
				</div>
				<div class="tkt-banner__text">
					<p class="tkt-banner__title" style="font-size: 28px;">{{ t._('Não percas nenhum concerto.') }}</p>
					<p class="tkt-banner__desc">{{ t._('Recebe um WhatsApp quando o teu artista favorito anunciar um espetáculo.') }}</p>
				</div>
			</div>
			<div class="tkt-banner__right">
				<div class="tkt-banner__input-row">
					<div class="tkt-banner__field">
						<span>🇵🇹 +351</span>
						<input type="tel" name="whatsapp_phone" placeholder="{{ t._('O teu número de telemóvel') }}">
					</div>
					<a href="https://wa.me/351913666847" target="_blank" class="tkt-btn tkt-btn--primary">{{ t._('Quero receber alertas') }}</a>
				</div>
				<p class="tkt-banner__hint">{{ t._('Podes cancelar quando quiseres.') }}</p>
			</div>
		</div>
	</div>
</section>

<div style="background: var(--tkt-bg-elevated); height: 1px; width: 100%; max-width: 1440px; margin: 0 auto;"></div>

<section class="tkt-scope">
	<div class="tkt-container">
		<div class="tkt-promo">
			<div class="tkt-promo__left">
				<p class="tkt-promo__eyebrow">{{ t._('És promotor?') }}</p>
				<p class="tkt-promo__title">{{ t._('Venda o seu evento com a Tickett.com') }}</p>
				<p class="tkt-promo__desc">{{ t._('Tudo o que precisa para esgotar salas: bilheteira online, check-in, pagamentos e apoio dedicado.') }}</p>
				<div class="tkt-promo__actions">
					<a href="#" class="tkt-btn tkt-btn--primary" style="width: 169px;" data-toggle="modal" data-target="#vendaIngressoModal">{{ t._('Pedir Demonstração') }}</a>
					<a href="{{ url() }}company/sell" class="tkt-promo__more">
						{{ t._('Saiba mais') }}
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
					</a>
				</div>
			</div>
			<div class="tkt-promo__feats">
				<div class="tkt-promo__feat">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v1.5a1.5 1.5 0 0 0 0 3V16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1.5a1.5 1.5 0 0 0 0-3z"></path></svg>
					<span>{{ t._('Bilheteira Online') }}</span>
				</div>
				<div class="tkt-promo__feat">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><line x1="14" y1="14" x2="21" y2="21"></line><line x1="21" y1="14" x2="14" y2="21"></line></svg>
					<span>{{ t._('Check-in Simples') }}</span>
				</div>
				<div class="tkt-promo__feat">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
					<span>{{ t._('Pagamentos Seguros') }}</span>
				</div>
				<div class="tkt-promo__feat">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>
					<span>{{ t._('Apoio Técnico') }}</span>
				</div>
			</div>
		</div>
	</div>
</section>
