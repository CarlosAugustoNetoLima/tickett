<section class="download-app">
    <div class="bg">
        <img src="{{ url() }}assets/images/bg-download-section.png" alt="Download Background" class="bg-image">
    </div>
    <div class="container">
        <div class="download-app-inner">
            <div class="side-phone">
                <img src="{{ url() }}assets/images/download-app-screen.png" alt="Screen of our app" class="phone-screen">
            </div>
            <div class="side-content">
                <h3 class="title">Baixe o aplicativo</h3>
                <p class="description">Baixe nosso aplicativo e fique informado sobre todos os eventos, notícias e muito mais.
                </p>
                <div class="download-buttons">
                    <a href="#" class="download-link">
                        <img src="{{ url() }}assets/images/button/download-google-play.png" alt="Google Play" class="download-button">
                    </a>
                    <a href="#" class="download-link">
                        <img src="{{ url() }}assets/images/button/download-app-store.png" alt="App Store" class="download-button">
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>