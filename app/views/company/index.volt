<main>
	<article class="internal-content">
		<div class="container">
			<div class="internal-content-inner">
				<div class="content-text">
					<div class="text-group">

						<!-- LIGHT SECTION -->
						<section class="lightSection clearfix pageHeader">
							<div class="container">
								<div class="row">
									<div class="col">
										<div class="page-title">
											<h2>{{ t._('about') }}</h2>
										</div>
									</div>
								</div>
							</div>
						</section>

						<!-- MAIN CONTENT SECTION -->
						<section class="mainContent clearfix aboutUsInfo">
							<div class="container">
								<div class="page-header">
									<h3>{{ config.company.about_title }}</h3>
								</div>
								<div class="row">
									<div class="col-md-6 order-sm-12">
										<img class="img-fluid" src="{{ url() }}img/about-us/title-img.jpg" alt="{{ config.company.name }}">
									</div>
									<div class="col-md-6 order-sm-1">
										{{ t._('about_bl01') }}
										{{ t._('about_bl02') }}
										{{ t._('about_bl03') }}
										{{ t._('about_bl04') }}
										{{ t._('about_bl05') }}
										{{ t._('about_bl06') }}
										{{ t._('about_bl07') }}
										{{ t._('about_bl08') }}
										{{ t._('about_bl09') }}
									</div>
								</div>
							</div>
						</section>

					</div>
				</div>
			</div>
		</div>
	</div>
</main>